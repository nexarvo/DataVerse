{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"],
      "detail": "Generated task to run cargo build",
      "cwd": "${workspaceFolder}/backend" // Ensure the cwd is set to /backend
    }
  ]
}
