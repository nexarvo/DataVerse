{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch and Run",
      "type": "shell",
      "command": "cargo",
      "args": ["watch", "-x", "run"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "rust",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^error\\[([a-zA-Z0-9_]+)\\]:\\s+(.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^(\\s+)-->\\s+(.*):(\\d+):(\\d+)",
            "file": 2,
            "line": 3,
            "column": 4
          }
        ]
      }
    }
  ]
}
